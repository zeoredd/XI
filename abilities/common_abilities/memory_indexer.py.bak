#!/usr/bin/env python3
"""
🧠 memory_indexer.py
Indexes all XI memory JSON files into PostgreSQL using pgvector.
Extracts entries, generates 1024-dim local embeddings, and stores with metadata.
Deduplicates using SHA256 hashes.
"""

